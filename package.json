{
  "name": "vue-keyboard-input",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:rime-configs": "node ./scripts/ime-parse.cjs --path=./src/assets/ime",
    "gen:cnchar-dicts": "node ./scripts/zip_dictionaries.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cnchar": "^3.2.6",
    "idb": "^8.0.3",
    "simple-keyboard": "^3.8.61",
    "vue": "^3.5.13",
    "vuetify": "^3.8.9"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^14.0.0",
    "lodash": "^4.17.21",
    "sass": "^1.89.2",
    "sass-embedded": "^1.89.2",
    "signature_pad": "^5.1.2",
    "typescript": "~5.8.3",
    "unplugin-fonts": "^1.4.0",
    "vite": "^7.1.6",
    "vite-plugin-vuetify": "^2.1.2",
    "vue-i18n": "^11.1.12",
    "vue-tsc": "^3.0.7"
  }
}
